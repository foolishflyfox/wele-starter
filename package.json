{
  "name": "visink",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-strategy content .",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "predev": "test -d src/renderer/public/docs || pnpm docs:build",
    "dev": "pnpm dev:web",
    "dev:server": "nest start --watch",
    "dev:ui": "vite --config vite.web.config.ts",
    "dev:web": "concurrently -k \"pnpm dev:server\" \"pnpm dev:ui\"",
    "predev:app": "test -d src/renderer/public/docs || pnpm docs:build",
    "dev:app": "NODE_ENV=development electron-vite dev",
    "build": "pnpm check && pnpm build:server && pnpm build:ui",
    "build:prod": "pnpm build:server && pnpm build:ui && pnpm copy:deps",
    "build:electron": "pnpm build:ui && pnpm build:server && electron-vite build",
    "build:app": "pnpm build:electron && electron-builder --config.directories.output=dist/visink-app/mac",
    "build:win": "pnpm build:electron && electron-builder --win --config.directories.output=dist/visink-app/win",
    "build:linux": "pnpm build:electron && electron-builder --linux --config.directories.output=dist/visink-app/linux",
    "build:server": "nest build",
    "build:ui": "vite build --config vite.web.config.ts",
    "copy:deps": "node scripts/copy-deps.js",
    "preview": "node dist/server/main.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/serve-static": "^5.0.4",
    "naive-ui": "^2.44.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.1",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unocss": "^66.6.7",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.2.6",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
